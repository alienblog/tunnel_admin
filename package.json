{
  "name": "tunneladmin",
  "private": true,
  "version": "0.2.13",
  "description": "Web SSH 连接管理器 + MCP server",
  "workspaces": [
    "server",
    "web"
  ],
  "main": "desktop/main.js",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "plugin:package": "node scripts/package-plugin.cjs",
    "start": "node server/dist/index.js",
    "desktop:start": "electron desktop/main.js",
    "dist:desktop": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis zip",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "terser": "^5.49.2",
    "typescript-language-server": "^5.3.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "adm-zip": "^0.5.18",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.2.0",
    "ssh2": "^1.16.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "com.tunneladmin.desktop",
    "productName": "TunnelAdmin",
    "asar": true,
    "asarUnpack": [
      "server/**",
      "node_modules/**"
    ],
    "files": [
      "build/icon.png",
      "desktop/main.js",
      "desktop/preload.js",
      "desktop/server-launch.js",
      "server/dist/**",
      "server/package.json",
      "web/dist/**",
      "!**/*.map"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "TunnelAdmin-${version}-${arch}.${ext}",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "artifactName": "TunnelAdmin-${version}-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TunnelAdmin"
    },
    "electronVersion": "33.4.11"
  },
  "engines": {
    "node": ">=22"
  }
}
